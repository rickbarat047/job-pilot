# JP-022 Windows worker - CONFIGURATION REFERENCE ONLY
#
# This file contains PLACEHOLDERS ONLY. It is not read by the scripts and must
# never contain a real token. install-worker.ps1 -Apply prompts for the values
# with masked input and writes them to a DPAPI-encrypted, user-only-ACL file
# (default: %LOCALAPPDATA%\JobPilotAI\worker\config\worker.env.enc).
#
# No script prints these values. Do not commit a filled copy of this file.

# Required. Base URL of the local/staging Next.js app (no trailing slash).
APP_URL=https://your-local-or-staging-app.example

# Required. Must match the app's WORKER_TOKEN. Use a local/staging test value.
WORKER_TOKEN=REPLACE_WITH_LOCAL_STAGING_TOKEN_ONLY

# Optional tuning keys (defaults shown). To use one, add it to the encrypted
# config with an encrypted value; the launcher decrypts every KEY=VALUE line.
POLL_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=15000
MAX_ATTEMPTS=4
RETRY_BASE_MS=500
RETRY_MAX_MS=30000
HEADLESS=true
BROWSER_TIMEOUT_MS=120000
