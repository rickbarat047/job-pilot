# ─── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
# Public origin used for CSRF checks and links
APP_URL=http://localhost:3000

# Database: leave DATABASE_URL empty for local SQLite
DATABASE_PATH=./data/jobpilot.db
DATABASE_URL=
POSTGRES_URL=
DATABASE_SSL=true
# Supabase Storage (optional; otherwise local filesystem storage is used)
SUPABASE_STORAGE_BUCKET=jobpilot
# Local encrypted file storage for CVs and generated documents
STORAGE_DIR=./storage

# 32-byte base64 or hex key. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# ─── Auth / security ─────────────────────────────────────────────────
SESSION_COOKIE_NAME=jobpilot_session
SESSION_TTL_DAYS=30
# Secret required to call /api/cron/tick from the scheduler
CRON_SECRET=change-me-local-cron-secret

# Shared rate limiting (required in production; app fails closed if missing)
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
# Shared secret for the Python Playwright worker
WORKER_TOKEN=change-me-local-worker-token

# Server-only comma-separated administrator emails (exact, normalized match).
# Leave blank to disable all admin access. Never expose this to the client.
ADMIN_EMAILS=

# ─── AI provider (OpenAI-compatible) ─────────────────────────────────
# Works with DeepSeek, OpenAI, Groq, Together, Ollama, OpenRouter, etc.
# The app runs fully without this key using the deterministic fallback engine.
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=
AI_TIMEOUT_MS=45000
AI_TEMPERATURE=0.2

# ─── Email (optional; never required for core functionality) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=JobPilot AI <no-reply@example.com>

# ─── Browser automation worker (optional) ────────────────────────────
# The worker polls APP_URL, so WORKER_URL is only used by tools that push to it.
WORKER_URL=http://localhost:8000
# Worker-only settings (set on Render/Fly/Docker, not on Vercel):
# ENABLE_POLLER=true
# POLL_INTERVAL_SECONDS=15
# HEADLESS=true
# DRY_RUN=false
# Demo mode is a global kill-switch. Candidate-level demo mode is in Settings.
DEMO_MODE=true

# ─── Production (Supabase / Vercel) ──────────────────────────────────
# The local app uses SQLite. supabase/migrations contains the production
# Postgres schema + RLS policies. See ARCHITECTURE.md for the migration path.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
