# Browser worker image: runs the Playwright-based auto-apply worker.
# Build: docker build -f Dockerfile.browser-worker -t jobpilot-browser-worker .
# Run:   docker run -e APP_URL=... -e WORKER_TOKEN=... jobpilot-browser-worker
FROM mcr.microsoft.com/playwright:v1.49.0-noble

WORKDIR /app
ENV NODE_ENV=production
ENV HEADLESS=true

# Install the Playwright JS library (the base image ships the browser binaries;
# the npm package must be installed explicitly).
COPY package.json ./package.json
RUN npm install playwright@1.49.0 --no-save --omit=dev

COPY scripts/browser-worker.mjs ./browser-worker.mjs

CMD ["node", "browser-worker.mjs"]